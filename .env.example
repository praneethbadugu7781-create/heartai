# HeartGuard AI Environment Configuration Template

# General
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=heartguard_db

# Security & Authentication (if enabled)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ensemble Risk Thresholds (Configurable)
RISK_THRESHOLD_LOW=0.35
RISK_THRESHOLD_MODERATE=0.65

# Model Ensemble Weights (Normalized automatically)
DNN_WEIGHT=0.35
MLP_WEIGHT=0.30
TABNET_WEIGHT=0.35

# Conversational AI API Keys (Optional - built-in clinical dialogue engine active by default)
GEMINI_API_KEY=
OPENAI_API_KEY=

# URL Configuration
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
